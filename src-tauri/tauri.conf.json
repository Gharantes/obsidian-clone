{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "obsidian-clone",
  "version": "0.0.3",
  "identifier": "com.obsidian-clone.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' img: http://img.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNTNDNkJFMTFEOEM0QUEKUldTcXhOZ1J2c1pUb25BWTFqVTd2RllsSU91OCtjWXM3b0NsVHk2Y2hSVFJsaXoxa3N3a3E3dUoK",
      "endpoints": ["https://github.com/Gharantes/obsidian-clone/releases/latest/download/latest.json"]
    }
  }
}
